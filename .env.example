# Copia este archivo como .env solo si quieres probar en local con el login real de Google.
# Sin nada de esto, `npm start` corre sin login (entras como pruebas@monkeylabs.cl) y con datos de prueba.
# Nunca pongas valores reales aquí: los secretos los pone Bruno directo en Railway.

# Modo: local (tu computador), pruebas (ambiente de pruebas, con franja y datos aparte) o produccion
MODO=local
PORT=5001

# Login con Google (el mismo cliente OAuth de Monkey System, proyecto «Grillas MonkeyLabs»)
GOOGLE_CLIENT_ID=
SESSION_SECRET=
DOMINIO_EQUIPO=monkeylabs.cl
ADMINS=bruno@monkeylabs.cl,emilio@monkeylabs.cl

# Integraciones con otros servicios (Metricool, Airtable, etc.): una línea por clave, con TUS claves de prueba.
# Las pegas tú directo en .env, nunca en el chat. Aquí van solo los nombres, sin valores.
# METRICOOL_TOKEN=

# Dónde vive
PUBLIC_URL=http://localhost:5001
MONKEY_SYSTEM_URL=https://monkey-system-production.up.railway.app
DATA_DIR=
